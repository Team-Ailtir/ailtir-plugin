{
  "mcpServers": {
    "ailtir": {
      "command": "uvx",
      "args": [
        "ailtir-mcp==2.1.0"
      ],
      "env": {
        "API_MCP_URL": "https://app.ailtir.ai",
        "LOG_FORMAT": "json",
        "LOG_LEVEL": "INFO",
        "MCP_HOST": "127.0.0.1",
        "MCP_PORT": "8000",
        "MCP_MOUNT_PATH": "/mcp"
      }
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-notion"
      ],
      "env": {
        "NOTION_API_KEY": "~~database"
      }
    },
    "m365": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-m365"
      ],
      "env": {
        "M365_TENANT_ID": "~~cloud_storage",
        "M365_CLIENT_ID": "~~cloud_storage",
        "M365_CLIENT_SECRET": "~~cloud_storage"
      }
    }
  }
}
